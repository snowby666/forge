# Keep the Docker build context small (large context = slow `docker compose build`, especially on WSL/NTFS).
__pycache__
*.pyc
.env
.env.*
!.env.example
.git
.vscode
.cursor
node_modules
**/node_modules
web/.next
web/node_modules
.venv
**/.venv
logs
*.log
docker/daytona
*.egg-info
dist
build
.mypy_cache
.pytest_cache
.ruff_cache
