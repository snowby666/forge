# Forge — Environment Variables
# Copy to .env and fill in values: cp .env.example .env
# This file is gitignored. All config lives here — no separate secrets file.

# Force UTF-8 encoding on Windows (prevents UnicodeDecodeError with non-ASCII chars)
PYTHONUTF8=1

# ── Core LLM (ElectronHub) ────────────────────────────────────────────────────
# Required. Get your key at https://electronhub.ai
ELECTRONHUB_API_KEY=your_electronhub_key
ELECTRONHUB_BASE_URL=https://api.electronhub.ai/v1

# ── Model overrides (SOTA defaults as of 2026-03-31) ─────────────────────────
# Change any tier to a different model from https://api.electronhub.ai/v1/models
# Uncomment the line to override the default.

# HEAVY tier — architecture, multi-file refactors, hard debugging
# Default: claude-opus-4-6 ($5/$25 per MTok) — 80.8% SWE-bench
# FORGE_MODEL_HEAVY=claude-opus-4-6

# STANDARD tier — most agent work, strategy, build, verify
# Default: claude-sonnet-4-6 ($3/$15 per MTok) — 79.6% SWE-bench
# FORGE_MODEL_STANDARD=claude-sonnet-4-6

# DESIGN tier — UI/UX design, component specs, design critique
# Default: claude-sonnet-4-6 (vision-capable, high temperature)
# FORGE_MODEL_DESIGN=claude-sonnet-4-6

# WRITING tier — README, pitch decks, demo scripts, copy
# Default: gpt-4.1 ($2/$8 per MTok) — strong instruction following
# FORGE_MODEL_WRITING=gpt-4.1

# BULK tier — tests, lint fixes, boilerplate, seed data
# Default: gpt-4.1-mini ($0.40/$1.60 per MTok) — cost-efficient coding
# FORGE_MODEL_BULK=gpt-4.1-mini

# FAST tier — hackathon scoring, browser actions, classification
# Default: gpt-5-nano ($0.05/$0.40 per MTok) — cheapest reasoning model
# FORGE_MODEL_FAST=gpt-5-nano

# VISION tier — screenshot analysis, Lighthouse review, design audit
# Default: claude-sonnet-4-6 (native vision support)
# FORGE_MODEL_VISION=claude-sonnet-4-6

# Budget mode (cheaper alternatives) — uncomment to override:
# FORGE_MODEL_HEAVY=claude-sonnet-4-6
# FORGE_MODEL_STANDARD=gpt-4.1
# FORGE_MODEL_DESIGN=gpt-4.1
# FORGE_MODEL_WRITING=gpt-4.1-mini

# Max output tokens per tier (defaults are generous — override only if you hit limits)
# FORGE_MAX_TOKENS_HEAVY=32000
# FORGE_MAX_TOKENS_STANDARD=16000
# FORGE_MAX_TOKENS_DESIGN=16000
# FORGE_MAX_TOKENS_WRITING=16000
# FORGE_MAX_TOKENS_BULK=8000
# FORGE_MAX_TOKENS_FAST=4000
# FORGE_MAX_TOKENS_VISION=16000

# ── ForgeSearch — Agentic Search Engine ───────────────────────────────────────
# 4-stage pipeline: query expansion → parallel retrieval → BM25+RRF → reranking.
# All keys below are OPTIONAL — SearXNG (self-hosted) works without any.
# Priority: Serper → Tavily → Brave → SearXNG (raced concurrently)

# Serper.dev — fastest (~120ms), real Google results. 2,500 free credits.
# Signup: https://serper.dev — HIGHLY RECOMMENDED
# SERPER_API_KEY=your_serper_key_here

# Tavily — AI-optimized search. 1,000 free/mo per key.
# Signup: https://app.tavily.com — supports multiple keys (comma-separated)
# TAVILY_API_KEY=tvly-your_key_here
# TAVILY_API_KEYS=tvly-key1,tvly-key2,tvly-key3

# Brave Search — independent 30B-page index. ~1,000 free/mo.
# Signup: https://api.search.brave.com/
# BRAVE_SEARCH_API_KEY=your_brave_key_here

# Exa — neural semantic search (judge/sponsor research). $7/1k reqs.
# Signup: https://exa.ai
# EXA_API_KEY=your_exa_key_here

# SearXNG — self-hosted metasearch (Docker). Fully free.
# SEARXNG_URL=http://localhost:8081
# SEARXNG_SECRET_KEY=change-this-in-production

# Cross-encoder reranker — free from HuggingFace, runs on GPU. Set "false" to disable.
# FORGE_SEARCH_RERANK=true

# ── Browser automation ────────────────────────────────────────────────────────
BROWSERBASE_API_KEY=your_browserbase_key
BROWSERBASE_PROJECT_ID=your_project_id
BROWSER_SERVER_URL=http://localhost:3100
BROWSER_SERVER_PORT=3100

# ── Design tools ──────────────────────────────────────────────────────────────
GOOGLE_STITCH_TOKENS=token1,token2,token3       # comma-separated; rotates across all; 350 gen/mo each
FIGMA_ACCESS_TOKEN=your_figma_pat
FIGMA_FILE_ID=your_figma_file_id

# ── Submission tools ──────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=your_elevenlabs_key         # $5/mo
ELEVENLABS_VOICE_ID=9BWtsMINqrJLrRacOk9x
GAMMA_API_KEY=your_gamma_key                   # free tier

# ── Deploy ────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=your_github_pat
GITHUB_ORG=your_org
VERCEL_TOKEN=your_vercel_token
VERCEL_ORG_ID=your_vercel_org

# ── Video ─────────────────────────────────────────────────────────────────────
YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret
YOUTUBE_REFRESH_TOKEN=your_youtube_refresh_token

# ── Notifications ─────────────────────────────────────────────────────────────
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/WEBHOOK/URL

# ── Google Calendar (service account — no browser needed) ─────────────────────
# 1. Create a service account at https://console.cloud.google.com/iam-admin/serviceaccounts
# 2. Download JSON key → save as ~/forge/google-service-account.json
# 3. Share your Google Calendar with the service account email
# 4. Enable Calendar API: https://console.cloud.google.com/apis/library/calendar-json.googleapis.com
# Run 'forge calendar-auth' for detailed instructions, 'forge calendar-test' to verify.
GOOGLE_CALENDAR_ID=your_calendar_id@gmail.com

# ── Web dashboard (forge web) ─────────────────────────────────────────────────
# FORGE_WEB_TOKEN=your-secret-token-here
# FORGE_WEB_URL=https://sentinelhive.dev

# ── Self-hosted infrastructure ────────────────────────────────────────────────
POSTGRES_USER=backbone
POSTGRES_PASSWORD=change_this_strong_password
DATABASE_URL=postgresql+asyncpg://backbone:change_this_strong_password@localhost:5432/backbone

REDIS_PASSWORD=change_this_strong_password
REDIS_URL=redis://:change_this_strong_password@localhost:6379

QDRANT_API_KEY=change_this_strong_key
QDRANT_URL=http://localhost:6333

TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=hackathon-agents

DAYTONA_SERVER_URL=http://localhost:3986

N8N_USER=admin
N8N_PASSWORD=change_this_strong_password
N8N_HOST=localhost

# ── System settings ───────────────────────────────────────────────────────────
ENVIRONMENT=production
LOG_LEVEL=INFO
MAX_CONCURRENT_HACKATHONS=3
HUMAN_APPROVAL_TIMEOUT_HOURS=24
UX_AUDIT_MIN_SCORE=7.0       # Minimum score for UX Auditor to approve (1-10)

# ── Feature flags ─────────────────────────────────────────────────────────────
# Comma-separated list of enabled flags, or set individual FORGE_FLAG_<NAME>=1
# Available flags:
#   SKIP_SECURITY_SCAN    Skip security agent (faster dev cycles)
#   FAST_BUILD_MODE       Use cheaper LLM tiers for build agents
#   FIGMA_AGENT           Enable experimental Figma-to-code agent
#   SKIP_INTEGRATION      Skip sponsor API integration (no prizes, faster build)
#   ULTRA_SAFE_MODE       Require human approval for every agent action
FORGE_FLAGS=
# FORGE_FLAG_SKIP_SECURITY_SCAN=1
