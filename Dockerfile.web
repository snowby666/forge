# Lightweight image for the Forge web dashboard (forge_web.py).
# Only installs the 4 packages the dashboard actually imports — no ML, no
# Playwright, no 2 GB PyTorch wheel.  Build context is the repo root.
#
#   docker build -f Dockerfile.web -t forge-web .
#   docker run -p 3000:3000 --env-file .env forge-web

FROM python:3.12-slim AS base

WORKDIR /app

RUN pip install --no-cache-dir \
    "fastapi>=0.115.0" \
    "uvicorn[standard]>=0.32.0" \
    "redis[asyncio]>=5.2.0" \
    "python-dotenv>=1.0.0"

COPY forge_web.py .
COPY config/redis_client.py config/redis_client.py

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:3000/health')" || exit 1

CMD ["uvicorn", "forge_web:app", "--host", "0.0.0.0", "--port", "3000", "--log-level", "info"]
