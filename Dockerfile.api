# FastAPI API backend for the Forge admin dashboard.
# Serves /api/* endpoints consumed by the Next.js frontend.
# Also includes the forge CLI for /api/scout, /api/hackathon/{id}/run, /api/test.
#
#   docker build -f Dockerfile.api -t forge-api .
#   docker run -p 3001:3001 --env-file .env forge-api

FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends git && \
    rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    "fastapi>=0.115.0" \
    "uvicorn[standard]>=0.32.0" \
    "redis[asyncio]>=5.2.0" \
    "python-dotenv>=1.0.0" \
    "websockets>=14.0" \
    "httpx>=0.28.0" \
    "pydantic>=2.0.0"

COPY pyproject.toml README.md ./
COPY forge.py ./
COPY config/ config/
COPY agents/ agents/
COPY forge_web.py .
COPY forge_web/ forge_web/

RUN pip install --no-cache-dir -e "." 2>/dev/null || \
    pip install --no-cache-dir -e ".[dev]" 2>/dev/null || true

ENV QDRANT_URL=http://qdrant:6333
ENV SEARXNG_URL=http://searxng:8080

EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:3001/health')" || exit 1

CMD ["uvicorn", "forge_web:app", "--host", "0.0.0.0", "--port", "3001", "--log-level", "info"]
