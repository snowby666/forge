# Browser Layer — Stagehand + Playwright HTTP server.
# Provides /scrape, /register, /submit, /screenshot, /lighthouse, /health.
#
#   docker build -f Dockerfile.browser -t forge-browser .
#   docker run -p 3100:3100 --env-file .env forge-browser

FROM node:20-slim

WORKDIR /app

# OS deps for Playwright Chromium + ffmpeg for /record-demo
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    libnss3 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 libxkbcommon0 \
    libxcomposite1 libxdamage1 libxrandr2 libgbm1 libpango-1.0-0 \
    libcairo2 libasound2 libxshmfence1 libx11-xcb1 libxfixes3 \
    fonts-liberation fonts-noto-color-emoji \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

COPY agents/browser/package.json agents/browser/package-lock.json* ./
RUN npm ci --prefer-offline 2>/dev/null || npm install

# Install Playwright Chromium browser binary
RUN npx playwright install chromium

# Lighthouse for /lighthouse endpoint
RUN npm install -g lighthouse

COPY agents/browser/ .

EXPOSE 3100

HEALTHCHECK --interval=30s --timeout=5s --retries=3 --start-period=15s \
    CMD curl -sf http://localhost:3100/health || exit 1

CMD ["npx", "tsx", "server.ts"]
